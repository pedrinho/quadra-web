{
  "name": "quadra-server",
  "version": "0.6.0-dev",
  "private": true,
  "description": "The Worker that serves Quadra Web and verifies the runs submitted to it",
  "license": "LGPL-2.1-or-later",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "bundle": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "migrate:local": "wrangler d1 migrations apply quadra --local",
    "migrate": "wrangler d1 migrations apply quadra --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "quadra-web": "*"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.21",
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.57.0"
  }
}
